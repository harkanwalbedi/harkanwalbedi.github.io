---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `${profile.name} is a ${profile.role} at ${profile.company} in ${profile.location}. Posts on low-latency AI agents and merged open-source contributions.`,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, Astro.site).href;
const onProjects = pathname.startsWith('/projects');

// Every script, stylesheet and font is a same-origin file, so the policy needs
// no 'unsafe-inline' and no third-party origins.
// TODO(security): frame-ancestors and X-Frame-Options only work as HTTP response
// headers, which GitHub Pages cannot set. Accepted: the site is static, has no
// forms, no sign-in and no state-changing actions, so there is nothing to clickjack.
const contentSecurityPolicy = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "font-src 'self'",
  "img-src 'self' data:",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Only in production builds: the dev server injects inline scripts for hot reload. */}
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14161a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-600-latin-opsz.woff2" as="font" type="font/woff2" crossorigin />
    {/* Blocking on purpose: applies a saved theme before first paint. */}
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main" id="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="brand" id="nav-brand">{profile.name}</a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/" aria-current={onProjects ? undefined : 'page'} id="nav-posts">Posts</a>
          <a href="/projects/" aria-current={onProjects ? 'page' : undefined} id="nav-projects">Projects</a>
          <button type="button" class="theme-btn" id="theme-toggle" aria-label="Toggle color theme" title="Toggle color theme">
            <Icon name="moon" size={18} class="icon-moon" />
            <Icon name="sun" size={18} class="icon-sun" />
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <ul class="footer-links" aria-label="Profiles">
          <li>
            <a href={profile.github} id="footer-github" target="_blank" rel="noopener me" aria-describedby="hint-new-tab">GitHub</a>
          </li>
          <li>
            <a href={profile.medium} id="footer-medium" target="_blank" rel="noopener me" aria-describedby="hint-new-tab">Medium</a>
          </li>
          <li>
            <a href={profile.linkedin} id="footer-linkedin" target="_blank" rel="noopener me" aria-describedby="hint-new-tab">LinkedIn</a>
          </li>
        </ul>
      </div>
    </footer>

    {/* Screen-reader descriptions for links that leave the site (referenced by aria-describedby). */}
    <div hidden>
      <span id="hint-new-tab">Opens in a new tab</span>
      <span id="hint-medium">Opens on Medium in a new tab</span>
      <span id="hint-github">Opens on GitHub in a new tab</span>
    </div>
  </body>
</html>
